# Copy to .env locally if needed. Never commit a real key. No live calls happen in Phase 4.
MODEL_API_KEY=
MODEL_PROVIDER_MODE=mock
# Live stays off unless this is exactly "true" AND a key is present. Leave false for the hackathon demo.
MODEL_LIVE_ENABLED=false
MODEL_MAX_RETRIES=2
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3
MODEL_TIMEOUT_MS=5000
MODEL_MAX_INPUT_CHARS=4000
MODEL_MAX_OUTPUT_CHARS=4000
MODEL_MAX_REQUESTS=50
PORT=4000
