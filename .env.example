# Copy to .env locally if needed. Never commit a real key. No live calls happen in Phase 4.
MODEL_API_KEY=
MODEL_PROVIDER_MODE=mock
# Live stays off unless this is exactly "true" AND a key is present. Leave false for the hackathon demo.
MODEL_LIVE_ENABLED=false
MODEL_MAX_RETRIES=2
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3
MODEL_TIMEOUT_MS=5000
MODEL_MAX_INPUT_CHARS=8000
# Caps the provider's whole response body; lower values can reject a valid answer as oversized.
MODEL_MAX_OUTPUT_CHARS=20000
# Caps outgoing provider request attempts per API process, retries included (resets on restart).
MODEL_MAX_REQUESTS=50
PORT=4000
# API safety limits (optional; defaults shown). The API token is not set here: the API
# creates it in %LOCALAPPDATA%\AgentShield\api-token on first start.
# API_MAX_EVENTS=1000
# API_RATE_LIMIT_PER_MINUTE=600
# API_LOGIN_RATE_LIMIT_PER_MINUTE=10
# API_EVALUATE_RATE_LIMIT_PER_MINUTE=60
# API_APPROVAL_RATE_LIMIT_PER_MINUTE=60
# API_SESSION_IDLE_MINUTES=30
# API_SESSION_MAX_MINUTES=480
# Website scanning (M1). Off unless set to exactly true; see docs/scanning.md.
# SCAN_NETWORK_ENABLED=false
# Local lab only (independent of the switch above): exact loopback origins on ports 8080-8099, comma-separated.
# SCAN_LAB_MODE=false
# SCAN_LAB_ORIGINS=http://127.0.0.1:8081,http://127.0.0.1:8082
# Exposure checks (M2): nine fixed paths plus one baseline, only for scans that opt in. Off unless exactly true.
# SCAN_EXPOSURE_ENABLED=false
# Agent policies (M3-C). Unset: only the built-in demo-summarizer policy. When set, the file replaces it;
# an invalid file stops the API at start-up. Use an absolute path (a relative one resolves from the API
# process directory, apps/api under npm run dev:api). See docs/agent-policies.md.
# AGENT_POLICY_FILE=C:\path\to\agent-policies.json
# Agent credentials (M3-D): hashes only, never secrets. Default %LOCALAPPDATA%\AgentShield\agent-credentials.json.
# Manage with: npm run agent-credential -w @agentshield/api -- create|list|revoke|rotate. See docs/agent-identity.md.
# AGENT_CREDENTIAL_FILE=C:\path\to\agent-credentials.json
# Legacy bearer agent credentials (M3-D). Off unless exactly true. New credentials are Ed25519 and do not need it.
# Set true only temporarily while migrating bearer agents (rotate them to Ed25519); see docs/agent-identity.md.
# AGENT_BEARER_ALLOWED=false
# Allowed clock skew for signed agent requests (M3-E E3), whole seconds from 5 to 300. Unset means 30;
# any other value stops the API at start-up.
# AGENT_SIGNATURE_MAX_SKEW_SECONDS=30
# Failed Authorization-header attempts per minute before 429 (dashboard sessions are not affected).
# API_AUTH_FAILURE_RATE_LIMIT_PER_MINUTE=20
